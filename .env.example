# Comma-separated time sources (hostnames or addresses). Prefix an entry with
# pool:, server:, or peer: to set its type, for example:
# NTP_SERVERS=pool:0.pool.ntp.org,server:time.cloudflare.com,peer:192.168.1.20
NTP_SERVERS=0.pool.ntp.org,1.pool.ntp.org,2.pool.ntp.org,3.pool.ntp.org

# Default type for unprefixed NTP_SERVERS entries: pool, server, or peer.
NTP_SOURCE_TYPE=pool

# Network allowed to query this server (for example, 192.168.1.0/24).
# Use "all" for every reachable client or leave empty to disable remote clients.
NTP_ALLOW=all

# Numeric Chrony service identity. Override at runtime without rebuilding
# (e.g. to match a host UID/GID mapping). GPSD device/SOCK access uses the
# container dialout group independently of CHRONY_GID.
CHRONY_UID=108
CHRONY_GID=20

# Chrony logging severity: 0=information, 1=warning, 2=error, 3=fatal.
LOG_LEVEL=0

# IANA timezone used inside the container.
TZ=America/New_York

# Disable Chrony's client-access log when set to true.
NOCLIENTLOG=false

# Require Network Time Security from every configured upstream server.
ENABLE_NTS=false

# Allow Chrony to adjust the host clock; requires the SYS_TIME capability.
# When true, disable every other host NTP client first (e.g. systemd-timesyncd),
# or chronyd logs "System clock interference detected" and exits.
ENABLE_SYSCLK=true

# Prefer GPSD's high-precision SOCK source. Do not enable with KERNEL_PPS.
ENABLE_GPSD_SOCK=true

# Use kernel PPS locked to GPSD's NMEA source instead of GPSD SOCK.
ENABLE_KERNEL_PPS=false

# Prefer the selected u-blox GPS/PPS source when it agrees with other sources.
GPS_PREFER=true

# Device basenames mapped under /dev by Compose. Both are required when
# ENABLE_GPSD_SOCK or ENABLE_KERNEL_PPS is true. On Pi hosts where PTP owns
# dead pps0, set DEV_PPS to the live GPIO node (often pps1).
DEV_TTY=ttyAMA0
DEV_PPS=pps0

# Receiver-specific NMEA timing for the clk SOCK (GPSD SOCK and kernel PPS).
NMEA_OFFSET=0.5
NMEA_DELAY=0.1

# Opt-in PHC/PTP source. Add its device mapping to Compose before enabling.
ENABLE_PTP=false
DEV_PTP=ptp0

# PHC-to-UTC correction in seconds; a TAI clock may require a negative offset.
PTP_OFFSET=0
